# modu web — environment variables
# Copy to .env.local and fill in your values

# Control plane URL (default: hosted on Render)
VITE_CONTROL_PLANE_URL=https://modu-to68.onrender.com

# Proxy URL (default: hosted on Render)
VITE_PROXY_URL=https://modu-proxy.onrender.com

# Algorand network (testnet | mainnet)
VITE_ALGORAND_NETWORK=testnet
